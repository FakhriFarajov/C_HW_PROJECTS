<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="167*" />
            <ColumnDefinition Width="633*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="105*" />
            <RowDefinition Height="108.01" />
            <RowDefinition Height="221*" />
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enter the credentials:" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Make:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="15" FontWeight="Bold" Margin="2,22,0,0"/>
        <TextBox HorizontalAlignment="Left" x:Name="MakeEntry" Margin="5,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="120"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="15" FontWeight="Bold" Margin="2,16,0,0"/>
        <TextBox HorizontalAlignment="Left" x:Name="ModelEntry" Margin="5,39,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Grid.Row="2" Grid.Column="0" Content="Search" HorizontalAlignment="Left" Margin="6,99,0,0" VerticalAlignment="Top" Width="120" Click="GetWeather" RenderTransformOrigin="0.517,4.675"/>

        <ScrollViewer HorizontalScrollBarVisibility="Visible" Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" >
            <DataGrid x:Name="DataGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="True" />
        </ScrollViewer>


    </Grid>
</Window>
