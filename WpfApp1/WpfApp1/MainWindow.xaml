<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/pexels-eberhardgross-1287145.jpg"/>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.6*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0.1*" />
        </Grid.RowDefinitions>




        <Border CornerRadius="20" Background="#99636363" BorderThickness="3"
        Grid.Row="1" Grid.Column="1">
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.6*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.25*" />
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="0.5*" />
                </Grid.RowDefinitions>
                <Button Grid.Column="0" FontSize="15"  Margin="10 10 0 0"  x:Name="SearchButton" Click="GetWeather" Content="Search"
                Background="LightGray" Foreground="Black" >
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20 0 0 20" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Search TextBox with Rounded Corners -->
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Margin="0 10 10 0" FontSize="15" x:Name="SearchBox" Background="#71A1A1A1"
                 Foreground="White">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0 20 20 0" Padding="5">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="CityName" FontSize="30" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />


                <Image x:Name="WeatherState" Grid.Row="1" Grid.Column="3" Margin="0 0 20 0"></Image>
                <TextBlock Grid.Row="1" Grid.Column="3"  x:Name="StateText" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <TextBlock Grid.Row="2" Grid.Column="3"   x:Name="MaxMinDegrees" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Grid.Row="2" Grid.Column="3"  Margin=" 0 10 0 0" x:Name="Degrees" FontSize="20" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" />


                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="Humidity" FontSize="15" Foreground="White" FontWeight="Bold"
                   HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="52,30,0,0" />

                <!-- Wind Speed -->
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="WindSpeed" FontSize="15" Foreground="White" FontWeight="Bold"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0,30,44,0" RenderTransformOrigin="0.482,1.017" />

            </Grid>
        </Border>




    </Grid>
</Window>
