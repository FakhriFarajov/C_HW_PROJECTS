<Window x:Class="Lesson5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson5"
        mc:Ignorable="d"
        Title="Server" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">
            <TextBox x:Name="ChatBox" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="0,0,0,40"/>
            <TextBox x:Name="MessageBox" Height="30" VerticalAlignment="Bottom"/>
            <Button Content="Send" Width="60" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>
